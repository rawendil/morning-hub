{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "shadcn-vue": {
            "command": "npx",
            "args": [
                "-y",
                "@jpisnice/shadcn-ui-mcp-server"
            ]
        },
        "clickup": {
            "command": "npx",
            "args": ["-y", "@hauptsache.net/clickup-mcp@latest"],
            "env": {
                "CLICKUP_API_KEY": "${CLICKUP_PERSONAL_API_KEY}",
                "CLICKUP_TEAM_ID": "REDACTED_TEAM_ID"
            }
        }
    }
}
